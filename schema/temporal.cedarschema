// Cedar schema for defakto-spiffe-temporal. Authored for CI validation and
// documentation of the entity/action model. Per the project design, the
// cedar-go validator is experimental, so runtime authorization does NOT depend
// on this schema — it is a CI/documentation artifact.
//
// No namespace wrapper: the authorizer and reference policy use unqualified
// identifiers (RoleClass, Namespace, Action::"..."), so the schema must too.
entity RoleClass;
entity VerbClass;
entity Namespace;

action "read-only", "start-signal", "worker", "break-glass", "forbidden-all"
  appliesTo {
    principal: [RoleClass],
    resource: [Namespace],
  };
